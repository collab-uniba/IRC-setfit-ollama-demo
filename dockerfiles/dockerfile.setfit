# Use an official Python runtime as a parent image
FROM python:3.12.7-slim

WORKDIR /app

# Copy pyproject.toml for package installation
COPY pyproject.toml ./

# Copy the shared package
COPY src/irc_setfit_ollama_demo ./src/irc_setfit_ollama_demo

# Copy config and scripts
COPY config ./config
COPY scripts/pull_models.py ./pull_models.py
COPY services/setfit_inference ./services/setfit_inference

# Install system dependencies required for some Python packages
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install the package and its dependencies
RUN pip install --no-cache-dir -e .

# Install the models
RUN chmod +x pull_models.py && \
    ./pull_models.py

# Make port 8000 available to the world outside this container
EXPOSE 8000

# Run the API server when the container launches
CMD ["uvicorn", "services.setfit_inference.setfit_api:app", "--host", "0.0.0.0", "--port", "8000"]