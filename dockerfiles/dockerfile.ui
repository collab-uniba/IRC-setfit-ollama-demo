FROM python:3.12.7-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml for package installation
COPY pyproject.toml ./

# Copy the shared package
COPY src/irc_setfit_ollama_demo /app/src/irc_setfit_ollama_demo

# Install the package and its dependencies
RUN pip install --no-cache-dir -e .

# Copy config and service files
COPY config /app/config
COPY services/ui /app/

# Make port 7860 available to the world outside this container
EXPOSE 7860

# Run the UI application when the container launches
CMD ["python", "-m", "app"]
